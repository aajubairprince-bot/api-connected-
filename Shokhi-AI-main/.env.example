# -------------------------------------------------------------
# 🤖 Google Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
# -------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# -------------------------------------------------------------
# ⚡ Supabase Cloud Configuration (Authentication & PostgreSQL)
# Get credentials from your Supabase Project Settings -> API
# -------------------------------------------------------------
# Project URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Public Anon Key (Safe to use in frontend & client-side requests)
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Service Role Secret Key (STRICTLY SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Optional: Supabase JWT Secret for offline token validation
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# -------------------------------------------------------------
# 🔒 Flask Server Configuration
# -------------------------------------------------------------
SECRET_KEY=your_flask_secret_key_here
FLASK_PORT=5000
