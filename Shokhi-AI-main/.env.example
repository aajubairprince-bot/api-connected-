# -------------------------------------------------------------
# 🤖 Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
# -------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use:
# - gemini-1.5-pro (Recommended: Gemini Pro with deep reasoning & medical knowledge)
# - gemini-2.0-pro-exp-02-05 (Gemini 2.0 Pro Experimental)
# - gemini-2.0-flash (Fast & intelligent)
# - gemini-1.5-flash (Lightweight & quick)
# - Or any custom Gemini model ID
GEMINI_MODEL=gemini-1.5-pro

# Flask Configuration
SECRET_KEY=prova_ai_secure_key_2026
FLASK_PORT=5000
