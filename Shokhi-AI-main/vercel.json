{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/docs",
      "destination": "/www/docs.html"
    },
    {
      "source": "/docs.html",
      "destination": "/www/docs.html"
    },
    {
      "source": "/admin",
      "destination": "/www/admin.html"
    },
    {
      "source": "/admin.html",
      "destination": "/www/admin.html"
    },
    {
      "source": "/app",
      "destination": "/www/index.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/www/index.html"
    },
    {
      "source": "/landing",
      "destination": "/www/landing.html"
    },
    {
      "source": "/landing.html",
      "destination": "/www/landing.html"
    },
    {
      "source": "/",
      "destination": "/www/landing.html"
    },
    {
      "source": "/(.*)",
      "destination": "/www/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/notifications/trigger_eval",
      "schedule": "0 9 * * *"
    }
  ]
}
