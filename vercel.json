{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/Shokhi-AI-main/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/Shokhi-AI-main/api/index.js"
    },
    {
      "source": "/docs",
      "destination": "/Shokhi-AI-main/www/docs.html"
    },
    {
      "source": "/docs.html",
      "destination": "/Shokhi-AI-main/www/docs.html"
    },
    {
      "source": "/admin",
      "destination": "/Shokhi-AI-main/www/admin.html"
    },
    {
      "source": "/admin.html",
      "destination": "/Shokhi-AI-main/www/admin.html"
    },
    {
      "source": "/app",
      "destination": "/Shokhi-AI-main/www/index.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/Shokhi-AI-main/www/index.html"
    },
    {
      "source": "/landing",
      "destination": "/Shokhi-AI-main/www/landing.html"
    },
    {
      "source": "/landing.html",
      "destination": "/Shokhi-AI-main/www/landing.html"
    },
    {
      "source": "/",
      "destination": "/Shokhi-AI-main/www/landing.html"
    },
    {
      "source": "/(.*)",
      "destination": "/Shokhi-AI-main/www/$1"
    }
  ]
}
